# Copiez ce fichier en « .env » puis remplacez TOUTES les valeurs « changez-moi ».
# Le fichier .env ne doit jamais être publié (il est dans .gitignore).

# --- PostgreSQL (service ticket-service) ---
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=changez-moi

# --- Oracle (service sla-service) ---
# Mot de passe administrateur (SYS/SYSTEM)
ORACLE_PASSWORD=changez-moi
# Mot de passe de l'utilisateur applicatif « sla »
SLA_DB_PASSWORD=changez-moi

# --- Secrets applicatifs ---
# Longue chaîne aléatoire
DJANGO_SECRET_KEY=changez-moi
# Clé partagée entre Django et Spring Boot
SLA_API_KEY=changez-moi

# --- Comptes de démonstration (créés au premier démarrage si SEED_DEMO=true) ---
SEED_DEMO=true
DEMO_PASSWORD=changez-moi

# --- Ports exposés sur votre machine ---
FRONTEND_PORT=3000
DJANGO_PORT=8000
SLA_PORT=8081
POSTGRES_HOST_PORT=5432
ORACLE_HOST_PORT=1521

# --- Adresses vues depuis le NAVIGATEUR (à adapter en déploiement) ---
PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_FRONTEND_URL=http://localhost:3000
